NODE_ENV=production
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=https://chat.example.com
TRUST_PROXY=true

# Access Control & Moderation
INVITE_ONLY=true
# Generate with: openssl rand -hex 32 (MUST be changed before production startup)
ADMIN_SECRET=__CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32__
ADMIN_SESSION_TTL_MS=3600000

# Optional durable JSON file path for encrypted invite envelopes & IP blocklist ONLY
# Leave empty for strict RAM-only volatile operation (zero disk persistence)
STATE_FILE_PATH=

# Connection & Abuse Limits
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_IP=10
MAX_ROOM_SIZE=20
MAX_MESSAGE_BYTES=1048576
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MESSAGES=15
RATE_LIMIT_JOINS=5
VITE_PBKDF2_ITERATIONS=600000